<?xml version="1.0" encoding="utf-8"?>
<!--
  Die App braucht keine Berechtigung (kein Internet). Der Build prüft die fertige APK gegen eine
  Erlaubt-Liste (build.yml, „Berechtigungen prüfen“).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Datensicherung: Die Tablettenliste wird nicht in die Android-Cloud-Sicherung (Google-Konto) aufgenommen.
      Alles bleibt auf dem Gerät.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TablettenChecker">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
